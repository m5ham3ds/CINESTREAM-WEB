function applyLanguage(lang){const t=translations[lang];document.documentElement.lang=lang;document.documentElement.dir=lang==='ar'?'rtl':'ltr';localStorage.setItem('cinestream-lang',lang);document.querySelectorAll('[data-i18n]').forEach(el=>{const k=el.dataset.i18n;if(t[k]!==undefined)el.textContent=t[k]});const btn=document.getElementById('lang-btn');if(btn)btn.textContent=lang==='ar'?'EN':'AR';document.dispatchEvent(new CustomEvent('cine:language',{detail:lang}))}
window.cineSetLanguage=applyLanguage;window.cineSetTheme=t=>{document.documentElement.dataset.theme=t;localStorage.setItem('cinestream-theme',t)};
const savedTheme=localStorage.getItem('cinestream-theme');document.documentElement.dataset.theme=savedTheme==='light'?'light':'dark';const init=()=>applyLanguage(localStorage.getItem('cinestream-lang')==='en'?'en':'ar');if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
